diff --git a/experimental/builder/models/cosmos3/weights.py b/experimental/builder/models/cosmos3/weights.py
index 9d6c1f180f5d21159b92566ecc48dcd3257a8cbf..1cba4cfe58aebbaa3b2d0965f7022bf524267872 100644
--- a/experimental/builder/models/cosmos3/weights.py
+++ b/experimental/builder/models/cosmos3/weights.py
@@ -18,6 +18,23 @@ from __future__ import annotations
 
 import os
 
+import numpy as np
+
+
+def adapt_patch_embedding_weight_for_chw_input(weight: np.ndarray,
+                                               patch_size: int,
+                                               num_channels: int) -> np.ndarray:
+    """Match the shared runtime's CHW patches to Cosmos3's HWC checkpoint."""
+    expected_width = num_channels * patch_size**2
+    if (patch_size <= 0 or num_channels <= 0 or weight.ndim != 2
+            or weight.shape[1] != expected_width):
+        raise ValueError(
+            "Cosmos3 patch-embedding weight must have shape "
+            f"[out_features, {expected_width}], got {weight.shape}")
+    return np.ascontiguousarray(
+        weight.reshape(weight.shape[0], patch_size, patch_size,
+                       num_channels).transpose(0, 3, 1, 2).reshape(weight.shape))
+
 
 def _component_name(component: str) -> str:
     return str(component).replace("-", "_")
