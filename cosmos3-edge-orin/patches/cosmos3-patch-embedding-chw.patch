+class Cosmos3ReasonerPatchEmbedding(Linear):
+    """Checkpoint patch projection with columns adapted to runtime layout."""
+
+    def __init__(self, ctx, prefix: str, patch_size: int,
+                 num_channels: int) -> None:
+        super().__init__(ctx, prefix, rank=2, tensor_parallel=False)
+        self.patch_size = patch_size
+        self.num_channels = num_channels
+
+    def weight_descriptor(self):
+        if self.quant_type() != "fp16":
+            raise ValueError("Cosmos3 patch embedding requires FP16 weights")
+        descriptor = self.weights.linear(self.prefix, "fp16")
+        weight = adapt_patch_embedding_weight_for_chw_input(
+            descriptor.weight, self.patch_size, self.num_channels)
+        # The identity checkpoint recipe cannot reproduce permuted columns.
+        return replace(descriptor, weight=weight, weight_recipe=None)
 
 
