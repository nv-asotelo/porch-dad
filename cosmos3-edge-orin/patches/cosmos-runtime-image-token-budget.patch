     return rt::imageUtils::qwenSmartResize(height, width, mConfig.patchSize, mConfig.mergeSize,
-        mConfig.minImageTokensPerImage, mConfig.maxImageTokensPerImage, maxRatio);
+        mConfig.minImageTokensPerImage,
+        maxImageTokensPerImage == 0 ? mConfig.maxImageTokensPerImage : maxImageTokensPerImage, maxRatio);
+}
+
+std::tuple<int64_t, int64_t> QwenViTRunner::getImageResizeTarget(rt::imageUtils::ImageData const& image)
+{
+    int64_t const requested = image.maxImageTokensPerImage;
+    ELLM_CHECK(requested == 0
+            || (requested >= mConfig.minImageTokensPerImage && requested <= mConfig.maxImageTokensPerImage),
+        "max_image_tokens_per_image must be zero or within the loaded visual profile ["
+            + std::to_string(mConfig.minImageTokensPerImage) + ", "
+            + std::to_string(mConfig.maxImageTokensPerImage) + "]");
+    ELLM_CHECK(requested == 0 || (!image.isVideo && image.frames == 1),
+        "Per-request image token overrides currently support still images only");
+    auto const target = image.doResize
+        ? getResizedImageSize(image.frames, image.isVideo, image.height, image.width, 200, requested)
+        : std::make_tuple(image.height, image.width);
+    if (requested != 0)
+    {
+        int64_t const factor = mConfig.patchSize * mConfig.mergeSize;
+        auto const [height, width] = target;
+        ELLM_CHECK(height > 0 && width > 0 && height % factor == 0 && width % factor == 0,
+            "An image with a token override must produce positive patch-aligned dimensions");
+        int64_t const tokens = (height / factor) * (width / factor);
+        ELLM_CHECK(tokens >= mConfig.minImageTokensPerImage && tokens <= requested,
+            "Resized image is outside the requested visual token budget");
+    }
+    return target;
 }
 
