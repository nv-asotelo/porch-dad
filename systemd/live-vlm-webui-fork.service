[Unit]
Description=Live VLM WebUI (nv-asotelo fork: push + stream-URL sources) via cosmos3-edge-shim
After=network.target cosmos3-edge-shim.service
Wants=cosmos3-edge-shim.service
# Never let both WebUIs contend for port 8090.
Conflicts=live-vlm-webui.service

[Service]
Type=simple
User=orin
WorkingDirectory=/home/orin/live-vlm-webui-fork
# Run the fork from source. PYTHONPATH precedes site-packages, so the installed
# live-vlm-webui 0.4.0 package is left untouched and rollback is just stopping this unit.
Environment=PYTHONPATH=/home/orin/live-vlm-webui-fork/src
Environment=PATH=/home/orin/TensorRT-Edge-LLM/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/orin/TensorRT-Edge-LLM/.venv/bin/python -m live_vlm_webui.server --host 0.0.0.0 --port 8090 --model nvidia/Cosmos3-Edge --api-base http://localhost:8000/v1 --api-key EMPTY --reachy-host 192.168.6.162
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
