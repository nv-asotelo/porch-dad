[Unit]
Description=porch-dad: Frigate events -> Cosmos3-Edge scene description -> mobile feed
After=network-online.target docker.service cosmos3-edge-shim.service
Wants=network-online.target
Requires=cosmos3-edge-shim.service

[Service]
Type=simple
User=orin
Environment=PORCH_DAD_CONFIG=/home/orin/nvr/bridge/config.yaml
Environment=PATH=/home/orin/TensorRT-Edge-LLM/.venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/orin/nvr/bridge
ExecStart=/home/orin/TensorRT-Edge-LLM/.venv/bin/python /home/orin/nvr/bridge/porch_dad.py
Restart=on-failure
RestartSec=5
# Keep the bridge from ever competing with the model for RAM on an 8GB board.
MemoryMax=320M

[Install]
WantedBy=multi-user.target
