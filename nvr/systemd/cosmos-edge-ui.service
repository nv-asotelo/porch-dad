[Unit]
Description=Cosmos3-Edge streaming browser interface (Live Vision)
After=network.target cosmos3-edge-shim.service
Wants=cosmos3-edge-shim.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=orin
Group=orin
WorkingDirectory=/home/orin/nvr/ui
# Binds loopback only. LAN exposure is opt-in and deliberate: run enable_lan_ui.sh,
# which writes a cosmos-edge-ui.service.d/lan.conf drop-in and issues a self-signed
# cert. Nothing on the LAN can reach this until that is done on purpose.
ExecStart=/home/orin/TensorRT-Edge-LLM/.venv/bin/python /home/orin/nvr/ui/scripts/serve_ui.py --host 127.0.0.1 --port 8092
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
# The shim holds ~3.3 GB on an 8 GB board. A UI must never compete with it.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
