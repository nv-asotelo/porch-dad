[Unit]
Description=Push Frigate + Cosmos3-Edge events to a phone (ntfy/Pushover)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=orin
Environment=FRIGATE_NOTIFY_CONFIG=/home/orin/nvr/notify/config.yaml
ExecStart=/home/orin/TensorRT-Edge-LLM/.venv/bin/python /home/orin/nvr/notify/frigate_notify.py
Restart=on-failure
RestartSec=5
MemoryMax=128M

[Install]
WantedBy=multi-user.target
