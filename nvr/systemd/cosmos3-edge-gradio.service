[Unit]
Description=Cosmos Reason BYO-Video Gradio demo (standard Gradio, Cosmos3-Edge backend)
After=network.target cosmos3-edge-shim.service
Wants=cosmos3-edge-shim.service

[Service]
Type=simple
User=orin
WorkingDirectory=/home/orin/cosmos-cookbook/.agents/skills/byo-video/scripts
Environment=INFERENCE_BACKEND=nim_local
Environment=VLLM_BASE_URL=http://localhost:8000/v1
Environment=MODEL_NAME=nvidia/Cosmos3-Edge
Environment=GRADIO_PORT=7860
Environment=GRADIO_SHARE=false
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/orin/TensorRT-Edge-LLM/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/orin/TensorRT-Edge-LLM/.venv/bin/python gradio_cr2_byo.py
Restart=on-failure
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
