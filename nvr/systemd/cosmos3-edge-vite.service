[Unit]
Description=Cosmos3-Edge cookbook Vite site (nvidia-build-reason-vite)
After=network.target cosmos3-edge-shim.service
Wants=cosmos3-edge-shim.service

[Service]
Type=simple
User=orin
WorkingDirectory=/home/orin/cosmos-cookbook/apps/nvidia-build-reason-vite
Environment=NIM_BASE_URL=http://localhost:8000
Environment=NIM_SERVED_MODEL_NAME=nvidia/Cosmos3-Edge
Environment=PORT=5173
Environment=FRAME_EXTRACTOR_PYTHON=/home/orin/TensorRT-Edge-LLM/.venv/bin/python3
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
