# Demo mode (nvr/demo-mode.sh, serve_ui.py --demo-mode-script): one systemctl call per unit. Its
# containers need no sudo: orin is in the docker group.
orin ALL=(root) NOPASSWD: /usr/bin/systemctl stop frigate-notify, /usr/bin/systemctl start frigate-notify
orin ALL=(root) NOPASSWD: /usr/bin/systemctl stop porch-feed, /usr/bin/systemctl start porch-feed
orin ALL=(root) NOPASSWD: /usr/bin/systemctl stop porch-dad, /usr/bin/systemctl start porch-dad
orin ALL=(root) NOPASSWD: /usr/bin/systemctl stop breed-classifier, /usr/bin/systemctl start breed-classifier
orin ALL=(root) NOPASSWD: /usr/bin/systemctl stop x11vnc, /usr/bin/systemctl start x11vnc
