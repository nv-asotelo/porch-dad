+    def _on_disconnect(self, client: mqtt.Client, userdata: Any, *args: Any) -> None:
+        """Handle disconnection.
+
+        Signature differs by paho version: 1.6 passes (rc), 2.x passes
+        (disconnect_flags, reason_code, properties). Take the reason from whichever slot it
+        lands in instead of binding to one version.
+        """
+        rc = args[1] if len(args) >= 2 else (args[0] if args else None)
         _LOGGER.warning("Disconnected from MQTT broker: %s", rc)
         self._connected.clear()
