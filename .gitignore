__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Model artifacts and engines are large and device-specific — never commit them.
# TensorRT engines must be built on the target device anyway.
*.engine
*.onnx
*.onnx.data
*.safetensors
*.plan
models/
# Except the classifiers' meta.json (preprocessing and label maps: configuration, not an artifact).
# Their ONNX files and engines stay ignored by *.onnx and *.plan above.
!nvr/classifier/models/
engines/
onnx/

# Local scratch
*.log
.DS_Store

# Internal authoring scaffolding — never publish
FACTS.md

# cached event stills served by the RSS feed (runtime data)
nvr/feed/snapshots/
*.db

# Local Claude Code tooling permissions; machine-specific, not project config.
.claude/settings.local.json

# Python wheels: these land here from ad-hoc pip download runs and are not part of the repo.
*.whl

# VLM benchmark: frames show the household and stay on the LAN; results quote them
nvr/vlmbench/data/
nvr/vlmbench/results/

# Live Vision sample sets (classifier/README.md): photos fetched for the Pokémon set, and spot sets of
# your own frames, which stay on the LAN. samples.json, the Pokémon set's list, is tracked.
nvr/classifier/samples*/

# Per-box values compose reads (e.g. SCOUT_1F_WHEELED_IP) - LAN addresses stay off this public repo
nvr/.env
